# --- Cloudflare D1 (database) ---
# Dashboard > your account > find the Account ID in the right sidebar of any zone/overview page
CLOUDFLARE_ACCOUNT_ID=
# Created with: wrangler d1 create flipbook-db  (or via the dashboard, Workers & Pages > D1)
CLOUDFLARE_D1_DATABASE_ID=
# Create at: Dashboard > My Profile > API Tokens > Create Token > "Edit Cloudflare Workers" template
# (needs D1:Edit permission on your account)
CLOUDFLARE_D1_API_TOKEN=

# --- Cloudflare R2 (storage) ---
# Uses CLOUDFLARE_ACCOUNT_ID above. Dashboard > R2 > Manage R2 API Tokens > Create API Token (Object Read & Write)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=flipbook-storage
# Public bucket URL (r2.dev subdomain, or your own custom domain mapped to the bucket)
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
